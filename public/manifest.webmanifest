{
  "name": "Personal Tracker",
  "short_name": "Todo",
  "description": "Quản lý task, thói quen và mục tiêu cá nhân",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "lang": "vi",
  "dir": "ltr",
  "categories": ["productivity", "utilities"],
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "icons": [
    {
      "src": "/icons/cube.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/cube.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/cube.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/cube.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Thêm task nhanh",
      "short_name": "Thêm task",
      "url": "/?action=add-task",
      "icons": [
        { "src": "/icons/todo.png", "sizes": "96x96", "type": "image/png" }
      ]
    }
  ]
}
